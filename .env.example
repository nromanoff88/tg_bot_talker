# ==========================================
# Telegram Bot Configuration
# ==========================================
# Получите токен у @BotFather и обязательно выключите Privacy Mode (/setprivacy -> Disable)
TELEGRAM_BOT_TOKEN=1234567890:replace_with_your_bot_token

# ==========================================
# Admin Panel Authentication
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
JWT_SECRET_KEY=replace_with_random_64_char_secret_string_for_jwt_signing

# Порт, на котором будет доступна веб-админка
ADMIN_PORT=8080

# ==========================================
# Default LLM Provider (OpenAI-compatible: OpenRouter, OpenAI, Gemini, etc.)
# Все эти параметры можно также менять прямо на лету в веб-админке!
# ==========================================
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-replace_with_your_key

# Быстрая и дешёвая модель (роутер решений, извлечение фактов, саммари)
LLM_FAST_MODEL=google/gemini-2.5-flash

# Умная ролевая модель (генерация живых ответов и собственной инициативы)
LLM_SMART_MODEL=anthropic/claude-3.7-sonnet

# Модель эмбеддингов (OpenAI-compatible /embeddings)
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# ==========================================
# Infrastructure (PostgreSQL + pgvector & Redis)
# ==========================================
POSTGRES_USER=bot_talker
POSTGRES_PASSWORD=bot_talker_secret
POSTGRES_DB=bot_talker
DATABASE_URL=postgresql+asyncpg://bot_talker:bot_talker_secret@postgres:5432/bot_talker

REDIS_URL=redis://redis:6379/0

